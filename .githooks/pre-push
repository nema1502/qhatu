#!/bin/sh
# Última puerta antes de GitHub: revisa todos los commits que van a subir y el
# árbol de archivos completo, aunque algún commit se haya hecho con --no-verify.
if ! command -v node >/dev/null 2>&1; then
  echo "auditor: falta Node.js, así que no se puede revisar lo que subís." >&2
  exit 1
fi
exec node "$(dirname "$0")/../scripts/audit.mjs" --push
